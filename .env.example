# Microsoft Foundry project and agent
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_AGENT_NAME=gpt-6
FOUNDRY_AGENT_VERSION=1

# Values handed to applications that consume this provider
PROVIDER_MODEL_ID=gpt-6
PROVIDER_API_KEY=your-api-key-here

# Protects the dashboard's API-key reveal action.
ADMIN_API_KEY=your-admin-key-here

PUBLIC_BASE_URL=
ALLOWED_ORIGINS=
APP_ENVIRONMENT=production
APP_DEBUG=false
REQUEST_TIMEOUT_SECONDS=120
MAX_REQUEST_BYTES=2000000

# Azure Service Principal credentials (optional if using DefaultAzureCredential / Azure CLI)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure Cognitive Services Speech (TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=https://<your-speech-resource>.cognitiveservices.azure.com/
AZURE_SPEECH_VOICE=en-US-OnyxTurboMultilingualNeural

# Azure VoiceLive (Real-time Voice AI)
AZURE_VOICELIVE_ENDPOINT=https://<your-resource>.services.ai.azure.com/
AZURE_VOICELIVE_AGENT_ID=
AZURE_VOICELIVE_PROJECT_NAME=
AZURE_VOICELIVE_API_VERSION=2025-10-01
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural
AZURE_ENV_NAME=
AZURE_LOCATION=
AZURE_SUBSCRIPTION_ID=
AZURE_EXISTING_AIPROJECT_ENDPOINT=
